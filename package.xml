<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sas_kuka_control_template</name>
  <version>0.0.0</version>
  <description>A template for code interfacing with `sas_robot_driver_kuka`. Change it as needed.</description>
  <maintainer email="murilo.marinho@manchester.ac.uk">Murilo Marinho</maintainer>
  <license>LGPL</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sas_robot_driver_kuka</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>sas_common</exec_depend>
  <exec_depend>sas_core</exec_depend>
  <exec_depend>sas_robot_driver</exec_depend>

  <!-- dqrobotics (Python bindings used by installed scripts) has no rosdep
       key; it comes from PyPI `pip install dqrobotics`. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>    
